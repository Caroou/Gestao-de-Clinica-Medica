package com.clinicamedica.model;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;

public class Agenda {

    private List<Consulta> consultas;

    public Agenda() {
        this.consultas = new ArrayList<>();
    }

    public boolean agendarConsulta(Consulta novaConsulta) {
        if (novaConsulta == null) {
            return false;
        }

        for (Consulta c : consultas) {
            if (c.getStatus() == StatusConsulta.AGENDADO && c.getDataHora().isEqual(novaConsulta.getDataHora())) {
                return false;
            }
        }

        novaConsulta.agendar();
        consultas.add(novaConsulta);
        return true;
    }

    public boolean cancelarConsulta(int idConsulta) {
        Consulta consulta = buscarPorId(idConsulta);
        if (consulta != null) {
            consulta.cancelar();
            return true;
        }
        return false;
    }

    public boolean reagendarConsulta(int idConsulta, LocalDateTime novaDataHora) {
        Consulta consulta = buscarPorId(idConsulta);
        if (consulta != null) {
            consulta.reagendar(novaDataHora);
            return true;
        }
        return false;
    }

    public boolean realizarConsulta(int idConsulta) {
        Consulta consulta = buscarPorId(idConsulta);
        if (consulta != null) {
            consulta.realizar();
            return true;
        }
        return false;
    }

    public Consulta buscarPorId(int idConsulta) {
        for (Consulta c : consultas) {
            if (c.getId() == idConsulta) {
                return c;
            }
        }
        return null;
    }

    public List<Consulta> listarConsultasPorData(LocalDate data) {
        List<Consulta> lista = new ArrayList<>();
        for (Consulta c : consultas) {
            if (c.getDataHora().toLocalDate().isEqual(data)) {
                lista.add(c);
            }
        }
        return lista;
    }

    public List<Consulta> listarConsultasPorStatus(StatusConsulta status) {
        List<Consulta> lista = new ArrayList<>();
        for (Consulta c : consultas) {
            if (c.getStatus() == status) {
                lista.add(c);
            }
        }
        return lista;
    }

    public List<Consulta> getConsultas() {
        return consultas;
    }

    public void setConsultas(List<Consulta> consultas) {
        this.consultas = consultas;
    }
}